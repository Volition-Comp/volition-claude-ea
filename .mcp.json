{
  "mcpServers": {
    "odoo": {
      "command": "${USERPROFILE}\\.local\\bin\\odoo-mcp.exe",
      "args": ["--transport", "stdio"],
      "env": {
        "ODOO_URL": "https://volition-staging-03-july-34408301.dev.odoo.com",
        "ODOO_DB": "volition-staging-03-july-34408301",
        "ODOO_USERNAME": "${ODOO_LOGIN}",
        "ODOO_PASSWORD": "${ODOO_API_KEY}",
        "ODOO_API_KEY": "${ODOO_API_KEY}",
        "ODOO_TRANSPORT": "json2",
        "ODOO_JSON2_DATABASE_HEADER": "1",
        "ODOO_MCP_ENABLE_WRITES": "1",
        "ODOO_MCP_ALLOWED_SIDE_EFFECT_METHODS": "mail.activity.action_feedback"
      }
    },
    "odoo-prod": {
      "command": "${USERPROFILE}\\.local\\bin\\odoo-mcp.exe",
      "args": ["--transport", "stdio"],
      "env": {
        "ODOO_URL": "https://www.volitioncomponents.com",
        "ODOO_DB": "shahid-malik-volition-production-12281539",
        "ODOO_USERNAME": "${ODOO_LOGIN}",
        "ODOO_PASSWORD": "${ODOO_PROD_API_KEY}",
        "ODOO_API_KEY": "${ODOO_PROD_API_KEY}",
        "ODOO_TRANSPORT": "json2",
        "ODOO_JSON2_DATABASE_HEADER": "1",
        "ODOO_MCP_ENABLE_WRITES": "1",
        "ODOO_MCP_ALLOWED_SIDE_EFFECT_METHODS": "mail.activity.action_feedback"
      }
    },
    "google-marketing": {
      "command": "${USERPROFILE}\\.config\\google-marketing\\.venv\\Scripts\\python.exe",
      "args": ["${USERPROFILE}\\.config\\google-marketing\\server.py"],
      "env": {
        "GOOGLE_ADS_ENABLE_WRITES": "1"
      }
    }
  }
}
